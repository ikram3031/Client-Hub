{
  "name": "clienthub-monorepo",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "web-apps/admin",
    "web-apps/client",
    "web-apps/docsNlogs"
  ],
  "scripts": {
    "server": "tsx server/index.ts",
    "dev:admin": "npm run dev --prefix web-apps/admin",
    "dev:client": "npm run dev --prefix web-apps/client",
    "dev:docs": "npm run dev --prefix web-apps/docsNlogs",
    "build:admin": "npm run build --prefix web-apps/admin",
    "build:client": "npm run build --prefix web-apps/client",
    "build:docs": "npm run build --prefix web-apps/docsNlogs",
    "build:all": "npm run build:admin && npm run build:client && npm run build:docs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}